# ---- Six Point Markup configuration (R-3). Copy to .env and fill in. ----

# Postgres credentials used by both containers. DATABASE_URL is built from these in docker-compose.yml;
# set DATABASE_URL yourself only when running the app outside compose.
POSTGRES_USER=markup
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=markup
# DATABASE_URL=postgres://markup:change-me-db-password@localhost:5432/markup

# Signs session cookies. Required: the app refuses to start without it. Generate: openssl rand -hex 32
SESSION_SECRET=

# Public URL (used for links, the CSRF origin check, and Secure cookies when it starts with https)
APP_URL=http://localhost:8080

# First admin, created only when no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Largest plan upload accepted, in MB
UPLOAD_MAX_MB=100
# Resolution for PDF pages converted to PNG
PDF_RENDER_DPI=150
# HTTP port inside the container
PORT=8080
# Host port published by docker compose
HOST_PORT=8080

# Optional
# LOG_LEVEL=info
# DATA_DIR=/data
